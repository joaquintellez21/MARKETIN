# ── Tu clave privada (OBLIGATORIA siempre) ──
PRIVATE_KEY=your_wallet_private_key_here

# ── Opción A: Cuenta con Gmail/Google (Privy) ──
# Solo necesitas tu PRIVATE_KEY. Deja SECRET y PASSPHRASE vacíos.
# El bot derivará las credenciales CLOB automáticamente.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# ── Opción B: Cuenta con MetaMask (CLOB tradicional) ──
# Descomenta y rellena las 3 credenciales:
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_SECRET=your_secret_here
# POLYMARKET_PASSPHRASE=your_passphrase_here

# Chain Configuration (137 = Polygon Mainnet)
CHAIN_ID=137

# Trading Configuration
MAX_POSITION_SIZE=17
STOP_LOSS_PERCENT=10
TAKE_PROFIT_PERCENT=20
ORDER_SIZE=5
DRY_RUN=true

# Logging
LOG_LEVEL=INFO

# AI Filter (Claude analysis before each trade)
CLAUDE_API_KEY=your_claude_api_key_here
USE_AI_FILTER=true
MIN_CONFIDENCE=0.70

# Weather Strategy
WEATHER_MIN_EDGE=0.50
WEATHER_CITIES=Chicago,New York,Los Angeles

# Data Feed (WebSocket preferred, falls back to polling)
USE_WEBSOCKET=true
POLL_INTERVAL=15
